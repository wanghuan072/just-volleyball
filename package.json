{
  "name": "just-volleyball",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "prebuild": "node scripts/update-sitemap-dates.mjs && node scripts/build-seo-manifest.mjs",
    "indexnow:check": "node scripts/run-indexnow.mjs",
    "indexnow:send": "node scripts/run-indexnow.mjs --send",
    "seo:dates": "node scripts/update-sitemap-dates.mjs",
    "seo:check": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
