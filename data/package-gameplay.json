  "topics": {
    "rules": {
      "summary": [
        "Teams normally have three touches to return the ball; blocks do not use one.",
        "Consecutive touches by the same player are allowed in1v1, but otherwise restricted.",
        "Default sets are first to7 with a two-point margin; two set wins take the match.",
        "Serve behind the end line within15seconds; jump before crossing into play. Serve attacks, tips and blocks are prohibited."
      ],
