    "set": {
      "summary": [
        "Tap E for a slower toss toward the cursor.",
        "Charge E while aiming near yourself for a high set; aim farther away for a quicker set.",
        "An airborne set changes tempo. For a setter dump, aim across the net, jump set while tilting forward and stay in front of the attack line."
      ],
